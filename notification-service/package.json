    "migrations:setup:default:entityPermissionGroups": "node src/migrations/entityAdminPermissions.js --default && node src/migrations/entityCustomerPermissions.js --default && node src/migrations/entityPartnerPermissions.js --default && node src/migrations/entitySubsidiaryPermissions.js --default && node src/migrations/entitySuperAdminPermissions.js --default && node src/migrations/entityTechnicianPermissions.js --default",
