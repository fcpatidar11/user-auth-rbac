    "start:local": "npm install && pm2 start environment.local.config.js",
    "start:dev": "npm install && pm2 start environment.dev.config.js",
    "start:prod": "npm install && pm2 start environment.prod.config.js",
    "start:stage": "npm install && pm2 start environment.stage.config.js",
    "delete:local": "pm2 delete environment.local.config.js",
    "delete:dev": "pm2 delete environment.dev.config.js",
    "delete:prod": "pm2 delete environment.prod.config.js",
    "delete:stage": "pm2 delete environment.stage.config.js",
    "restart:local": "npm install && pm2 restart environment.local.config.js",
