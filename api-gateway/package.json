{
  "name": "authentication-service",
  "version": "1.0.0",
  "description": "Authentication service for managing user credentials and authorization",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.2"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",    
    
    "start:local": "npm install && pm2 start environment.local.config.js",
    "start:dev": "npm install && pm2 start environment.dev.config.js",
    "start:stage": "npm install && pm2 start environment.stage.config.js",
    "start:prod": "npm install && pm2 start environment.prod.config.js",
    
    "stop:local": "pm2 stop environment.local.config.js",
    "stop:dev": "pm2 stop environment.dev.config.js",
    "stop:stage": "pm2 stop environment.stage.config.js",
    "stop:prod": "pm2 stop environment.prod.config.js",
    
    "restart:local": "npm install && pm2 restart environment.local.config.js",
    "restart:dev": "npm install && pm2 restart environment.dev.config.js",
    "restart:stage": "npm install && pm2 restart environment.stage.config.js",
    "restart:prod": "npm install && pm2 restart environment.prod.config.js",
    
    "delete:local": "pm2 delete environment.local.config.js",
    "delete:dev": "pm2 delete environment.dev.config.js",
    "delete:stage": "pm2 delete environment.stage.config.js",
    "delete:prod": "pm2 delete environment.prod.config.js",
    
    "logs": "pm2 logs",
    "docs": "jsdoc -c jsdoc.json"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fs": "^0.0.1-security",
    "i18n": "^0.15.1",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "pm2": "^5.4.3",
    "rotating-file-stream": "^3.2.6",
    "sharp": "^0.34.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  }
}
